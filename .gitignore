# data & state (re-derivable or operational — never in git)
# NOTE: patterns are anchored to the repo root — an unanchored `data/` would
# also ignore `src/alphaforge/data/` (it silently hid the Phase 2 sources).
/data/
/var/
/artifacts/
.env

# python
__pycache__/
*.pyc
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
dist/
*.egg-info/

# coverage (pytest-cov writes these on every run; the report is CI-only)
.coverage
.coverage.*
coverage.xml
htmlcov/

# per-sleeve operational state (same rule as /var/ — these are runtime DBs, logs and
# experiment ledgers, not source. They were untracked-but-not-ignored, which meant a
# `git add -A` would have committed live sqlite files.)
/var_mf/
/var_mf_exp/
/var_sharadar/
/var_fut_real/
# 2026-08-18: var_inventory/ was untracked-but-not-ignored and a `git add -A` DID stage its live
# ops.sqlite. That is the exact failure this block's comment already warned about, repeated. The
# rule is per-directory and every new var_* sleeve dir must be added here the day it is created.
/var_inventory/

# throwaway working files
/scratch/
/scratchpad/
*.bak
